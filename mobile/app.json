{
  "expo": {
    "name": "Pacifica",
    "slug": "pacifica",
    "owner": "pacificacrm",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "pacifica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F3F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pacificacrm.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Pacifica uses the microphone for business calls when calling features are enabled."
      }
    },
    "android": {
      "package": "com.pacificacrm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101216",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-notifications",
        {
          "color": "#FFFFFF",
          "defaultChannel": "pacifica",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F2F3F5",
          "dark": {
            "backgroundColor": "#101216",
            "image": "./assets/splash-mark-dark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of contact details for Pacifica AI.",
          "photosPermission": "Choose a photo to read contact details with Pacifica AI.",
          "microphonePermission": "Pacifica uses the microphone for business calls when you enable calling."
        }
      ],
      "@twilio/voice-react-native-sdk",
      "./plugins/with-pacifica-messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://pacificacrm.com",
      "router": {},
      "eas": {
        "projectId": "81a757fb-5912-49c8-8f7a-821eded66e39"
      }
    }
  }
}
